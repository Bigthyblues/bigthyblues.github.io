---
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  bodyId?: string;
}

const {
  title,
  description = "Woof! Welcome to Blues' blocky site!",
  bodyId
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Bigthyblues, blues, bluesarts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/webicon.png" />
    <link rel="icon" href="/img/webicon.png" />
    <title>{title}</title>
  </head>
  <body id={bodyId}>
    <slot />
    <script is:inline>
      (() => {
        const padTime = (value) => String(value).padStart(2, "0");

        document.querySelectorAll("time[data-local-time]").forEach((element) => {
          const date = new Date(element.dateTime);
          if (Number.isNaN(date.valueOf())) return;

          element.textContent = `${date.getFullYear()}.${date.getMonth() + 1}.${date.getDate()}, ${padTime(date.getHours())}:${padTime(date.getMinutes())}`;
        });
      })();
    </script>
  </body>
</html>

