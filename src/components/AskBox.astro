---
interface Props {
  slug?: string;
  submitUrl?: string;
}

const {
  slug = "about-ask",
  // GitHub Pages builds do not receive the local .env file. This is a public
  // endpoint (not a secret), so retain a production fallback for static builds.
  submitUrl = (import.meta.env.PUBLIC_ZISCUS_SUBMIT_URL as string | undefined)
    ?? "https://ziscus-ask.bigthyblues.workers.dev/submit"
} = Astro.props;

const configured = Boolean(submitUrl?.trim());
const action = configured ? submitUrl!.trim() : "#";
---

<div class="ask-box" id="ask-box" data-ask-box>
  <p class="ask-box-thanks" role="status" data-ask-thanks hidden>
    Got it! Your question has been sent to Blues now!
  </p>

  <form
    class="ask-box-form"
    method="POST"
    action={action}
    data-ask-form
    data-configured={configured ? "true" : "false"}
  >
    <input type="hidden" name="slug" value={slug} />

    <label class="ask-box-field ask-box-name">
      <span class="visually-hidden">Name (optional)</span>
      <input
        type="text"
        name="author"
        maxlength="60"
        autocomplete="nickname"
        placeholder="Your name (optional)"
        data-ask-author
      />
    </label>

    <label class="ask-box-field ask-box-question">
      <span class="visually-hidden">Your question</span>
      <textarea
        name="body"
        rows="5"
        minlength="2"
        maxlength="2000"
        placeholder="What would you like to ask?"
        data-ask-body
      ></textarea>
    </label>

    <button class="ask-box-submit" type="submit" disabled={!configured}>
      Send to Blues now!
    </button>
  </form>

  <p class="ask-box-setup-note" role="alert" data-ask-error hidden></p>

  {
    !configured && (
      <p class="ask-box-setup-note">
        The ask box is almost ready — Blues is still plugging in the mailbox. Please check back soon!
        {
          import.meta.env.DEV && (
            <>
              {" "}
              <span class="ask-box-dev-hint">
                (dev) set <code>PUBLIC_ZISCUS_SUBMIT_URL</code> in <code>.env</code>
              </span>
            </>
          )
        }
      </p>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ask-box]").forEach((box) => {
    const form = box.querySelector<HTMLFormElement>("[data-ask-form]");
    const authorInput = box.querySelector<HTMLInputElement>("[data-ask-author]");
    const questionInput = box.querySelector<HTMLTextAreaElement>("[data-ask-body]");
    const thanks = box.querySelector<HTMLElement>("[data-ask-thanks]");
    const error = box.querySelector<HTMLElement>("[data-ask-error]");
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.configured !== "true") {
        return;
      }

      if (!questionInput?.value.trim()) {
        window.alert("Hmmm... Maybe you forget to write something in the box.");
        questionInput?.focus();
        return;
      }

      // Ziscus requires an author value; empty optional names become Anonymous.
      if (authorInput && !authorInput.value.trim()) {
        authorInput.value = "Anonymous";
      }

      if (button?.disabled) return;
      if (button) button.disabled = true;
      if (error) error.hidden = true;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form)
        });
        const result = await response.json();
        if (!response.ok || result.ok !== true) throw new Error(result.error || "Your question could not be sent. Please try again.");
        form.hidden = true;
        if (thanks) thanks.hidden = false;
      } catch {
        if (error) {
          error.textContent = "Oh no... Something went wrong while sending the question... Maybe you can try again later.";
          error.hidden = false;
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
